<!DOCTYPE html>

<html>

<head>

    <meta charset="UTF-8">
    <title>YouTube Downloader</title>
    <link rel="stylesheet" href="/styles.css">

</head>

<body>

    <div class="container">

    <h1>yt-extractor</h1>

    <!-- INSPECT FORM -->

    <form action="/inspect" method="POST">

        <input
            type="text"
            name="url"
            placeholder="YouTube URL"
            required
        >

        <button type="submit">
            Inspect
        </button>

    </form>


    <% if (info) { %>

        <hr>

        <h2>
            <%= info.title %>
        </h2>

        <p>
            Channel: <%= info.uploader %>
        </p>

        <img
            src="<%= info.thumbnail %>"
            width="400"
        >


        <!-- 1. VIDEO -->

        <section>

            <h2>Download Video</h2>

            <form action="/download/video" method="POST">

                <input
                    type="hidden"
                    name="url"
                    value="<%= url %>"
                >

                <label>
                    <input
                        type="radio"
                        name="quality"
                        value="low"
                        required
                    >
                    Low
                </label>

                <label>
                    <input
                        type="radio"
                        name="quality"
                        value="medium"
                    >
                    Medium
                </label>

                <label>
                    <input
                        type="radio"
                        name="quality"
                        value="best"
                    >
                    Best
                </label>

                <button type="submit">
                    Download MP4
                </button>

            </form>

        </section>


        <!-- 2. AUDIO -->

        <section>

            <h2>Download Audio</h2>

            <form action="/download/audio" method="POST">

                <input
                    type="hidden"
                    name="url"
                    value="<%= url %>"
                >

                <label>
                    <input
                        type="radio"
                        name="quality"
                        value="low"
                        required
                    >
                    Low
                </label>

                <label>
                    <input
                        type="radio"
                        name="quality"
                        value="medium"
                    >
                    Medium
                </label>

                <label>
                    <input
                        type="radio"
                        name="quality"
                        value="best"
                    >
                    Best
                </label>

                <button type="submit">
                    Download MP3
                </button>

            </form>

        </section>


        <!-- 3. SUBTITLES -->

        <section>

            <h2>Download Captions</h2>

            <form action="/download/caption" method="POST">

                <input
                    type="hidden"
                    name="url"
                    value="<%= url %>"
                >

                <select name="language" required>

                    <option value="">
                        Select language
                    </option>

                    <% info.subtitles.forEach(language => { %>

                        <option value="<%= language %>|subtitle">
                            <%= language %> (Subtitle)
                        </option>

                    <% }) %>

                    <% info.automaticCaptions.forEach(language => { %>

                        <option value="<%= language %>|automatic">
                            <%= language %> (Automatic)
                        </option>

                    <% }) %>

                </select>

                <button type="submit">
                    Download Caption
                </button>

            </form>

        </section>


        <!-- 4. THUMBNAIL -->

        <section>

            <h2>Download Thumbnail</h2>

            <form action="/download/thumbnail" method="POST">

                <input
                    type="hidden"
                    name="url"
                    value="<%= url %>"
                >

                <button type="submit">
                    Download Best Quality Thumbnail
                </button>

            </form>

        </section>

    <% } %>

    </div>

</body>

</html>